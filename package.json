{
  "name": "aigc-ops-command-center",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:pages": "VITE_BASE_PATH=/aigc-ops-command-center/ pnpm build && PLAYWRIGHT_PAGES_PREVIEW=true playwright test tests/e2e/pages.spec.ts --project=desktop-chromium",
    "check": "pnpm typecheck && pnpm test:unit",
    "check:all": "pnpm check && pnpm test:e2e && pnpm test:e2e:pages"
  },
  "dependencies": {
    "@lucide/vue": "^1.49.0",
    "ant-design-vue": "^4.2.6",
    "echarts": "^6.1.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-echarts": "^8.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  }
}
